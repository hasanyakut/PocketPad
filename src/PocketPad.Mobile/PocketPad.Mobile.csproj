<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android only. -->
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>PocketPad.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>PocketPad</ApplicationTitle>
		<ApplicationId>com.pocketpad.mobile</ApplicationId>
		<ApplicationDisplayVersion>0.7.0</ApplicationDisplayVersion>
		<ApplicationVersion>11</ApplicationVersion>

		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- Adaptive icon: gradient background + glyph foreground; the glyph is pre-sized for the 108dp canvas. -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" ForegroundFile="Resources\AppIcon\appiconfg.png" ForegroundScale="0.82" />
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#050B3A" BaseSize="160,160" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\logo.png" BaseSize="64,64" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PocketPad.Shared\PocketPad.Shared.csproj" />
	</ItemGroup>

</Project>
