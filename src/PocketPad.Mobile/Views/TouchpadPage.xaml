<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PocketPad.Mobile.ViewModels"
             xmlns:controls="clr-namespace:PocketPad.Mobile.Controls"
             x:Class="PocketPad.Mobile.Views.TouchpadPage"
             x:DataType="vm:TouchpadViewModel"
             Title="Touchpad">
    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="12,16,12,12" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <controls:ConnectionBadge />
            <ImageButton Grid.Column="1" Source="ic_sensitivity.png" BackgroundColor="{StaticResource Surface}"
                         CornerRadius="14" WidthRequest="56" Padding="16" BorderColor="{StaticResource Border}" BorderWidth="1"
                         SemanticProperties.Description="Touchpad ayarları" Command="{Binding ToggleSettingsCommand}" />
        </Grid>

        <!-- Touchpad area: most of the screen. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" StrokeShape="RoundRectangle 24">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1F2430" Offset="0" />
                    <GradientStop Color="#191C23" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <VerticalStackLayout VerticalOptions="Center" Spacing="10" InputTransparent="True" Opacity="0.55">
                    <Image Source="tab_touchpad.png" WidthRequest="40" HeightRequest="40" Opacity="0.5" />
                    <Label Text="Bağlı değil" FontFamily="OpenSansSemibold" HorizontalOptions="Center"
                           IsVisible="{Binding Status.IsConnected, Converter={StaticResource InvertBool}}" />
                    <Label Text="Kaydır: imleç  ·  Dokun: sol tık&#10;Çift dokun: çift tık&#10;İki parmakla kaydır: sayfa kaydırma&#10;İki parmakla dokun: sağ tık"
                           LineHeight="1.3"
                           Style="{StaticResource Caption}" HorizontalTextAlignment="Center" Margin="24,0" />
                </VerticalStackLayout>
                <controls:TouchpadSurface x:Name="Surface" BackgroundColor="Transparent"
                                          IsEnabled="{Binding Status.IsConnected}" />
            </Grid>
        </Border>

        <!-- Settings (toggled by the button next to the status card) -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,10" IsVisible="{Binding ShowSettings}">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                <Label Text="İmleç hızı" Style="{StaticResource Caption}" VerticalOptions="Center" WidthRequest="92" />
                <Slider Grid.Column="1" Minimum="{x:Static vm:TouchpadViewModel.MinSensitivity}"
                        Maximum="{x:Static vm:TouchpadViewModel.MaxSensitivity}" Value="{Binding Sensitivity}"
                        MinimumTrackColor="{StaticResource Accent}" MaximumTrackColor="{StaticResource Border}"
                        ThumbColor="{StaticResource Accent}" VerticalOptions="Center" />
                <Label Grid.Column="2" Text="{Binding SensitivityText}" FontFamily="OpenSansSemibold" WidthRequest="44"
                       HorizontalTextAlignment="End" VerticalOptions="Center" />

                <Label Grid.Row="1" Text="Kaydırma hızı" Style="{StaticResource Caption}" VerticalOptions="Center" />
                <Slider Grid.Row="1" Grid.Column="1" Minimum="{x:Static vm:TouchpadViewModel.MinScrollSpeed}"
                        Maximum="{x:Static vm:TouchpadViewModel.MaxScrollSpeed}" Value="{Binding ScrollSpeed}"
                        MinimumTrackColor="{StaticResource Accent}" MaximumTrackColor="{StaticResource Border}"
                        ThumbColor="{StaticResource Accent}" VerticalOptions="Center" />
                <Label Grid.Row="1" Grid.Column="2" Text="{Binding ScrollSpeedText}" FontFamily="OpenSansSemibold" WidthRequest="44"
                       HorizontalTextAlignment="End" VerticalOptions="Center" />

                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="Ters kaydırma (klasik fare tekerleği yönü)" Style="{StaticResource Caption}"
                       VerticalOptions="Center" />
                <Switch Grid.Row="2" Grid.Column="2" IsToggled="{Binding ReverseScroll}" OnColor="{StaticResource Accent}"
                        ThumbColor="White" HorizontalOptions="End" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10" HeightRequest="64" IsEnabled="{Binding Status.IsConnected}">
            <Button Text="Sol tık" ImageSource="ic_mouse_left.png" ContentLayout="Left, 10" Style="{StaticResource SubtleButton}"
                    Command="{Binding LeftClickCommand}" />
            <Button Grid.Column="1" Text="Sağ tık" ImageSource="ic_mouse_right.png" ContentLayout="Left, 10" Style="{StaticResource SubtleButton}"
                    Command="{Binding RightClickCommand}" />
        </Grid>
    </Grid>
</ContentPage>
