<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PocketPad.Mobile.ViewModels"
             x:Class="PocketPad.Mobile.Controls.ConnectionBadge"
             x:DataType="vm:ConnectionStatusViewModel">
    <Border Style="{StaticResource Card}" Padding="14,12">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
            <!-- Status dot with a soft halo -->
            <Grid Grid.RowSpan="2" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                <Ellipse Fill="{Binding IndicatorColor}" Opacity="0.25" />
                <Ellipse Fill="{Binding IndicatorColor}" WidthRequest="10" HeightRequest="10"
                         HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
            <Label Grid.Column="1" Text="{Binding Text}" FontFamily="OpenSansSemibold" VerticalOptions="Center" LineBreakMode="TailTruncation" />
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource Caption}"
                   IsVisible="{Binding Detail, Converter={StaticResource NotNullConverter}}" />
        </Grid>
    </Border>
</ContentView>
