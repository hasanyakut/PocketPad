<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PocketPad.Mobile.Controls.LiveTypingBar"
             x:Name="Root">
    <Border Style="{StaticResource Card}" Padding="12,6,6,6">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <Entry x:Name="Field" Placeholder="Yazın, anında gider" BackgroundColor="Transparent"
                   IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" ReturnType="Send" ClearButtonVisibility="Never"
                   TextChanged="OnTextChanged" Completed="OnCompleted" />
            <ImageButton Grid.Column="1" Source="ic_backspace.png" BackgroundColor="{StaticResource SurfaceRaised}" CornerRadius="12"
                         WidthRequest="48" HeightRequest="48" Padding="12" SemanticProperties.Description="Geri sil"
                         Clicked="OnBackspaceClicked" />
            <ImageButton Grid.Column="2" Source="ic_enter.png" BackgroundColor="{StaticResource Accent}" CornerRadius="12"
                         WidthRequest="48" HeightRequest="48" Padding="12" SemanticProperties.Description="Enter"
                         Clicked="OnEnterClicked" />
        </Grid>
    </Border>
</ContentView>
