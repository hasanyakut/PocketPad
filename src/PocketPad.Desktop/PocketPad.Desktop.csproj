<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon (system tray). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PocketPad.Desktop</RootNamespace>
    <AssemblyTitle>PocketPad</AssemblyTitle>
    <!-- Required by LibraryImport source generation (SendInput). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\PocketPad.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid WPF / WinForms / System.Drawing type ambiguities. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- DI, logging and DPAPI (ProtectedData) come from the Microsoft.AspNetCore.App / WindowsDesktop frameworks. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PocketPad.Shared\PocketPad.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PocketPad.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PocketPad.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
