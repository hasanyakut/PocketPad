<Window x:Class="PocketPad.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PocketPad.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="PocketPad" Width="960" Height="740" MinWidth="800" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/PocketPad.Desktop;component/Assets/PocketPad.ico"
        Style="{StaticResource AppWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Source="pack://application:,,,/PocketPad.Desktop;component/Assets/logo.png" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PocketPad" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#33F0616D" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                            <Setter Property="Background" Value="#33F5B841" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasControlSession}" Value="True">
                                            <Setter Property="Background" Value="#333FCF8E" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Danger}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasControlSession}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ControlStatus}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Telefonunuzdan bu bilgisayarı fare, klavye ve medya tuşlarıyla kontrol edin." />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding LanAddresses}" SelectedItem="{Binding SelectedAddress}" Margin="0,0,8,0"
                              ToolTip="QR kodunda kullanılacak yerel IP adresi"/>
                    <Button Content="&#xE72C;" Style="{StaticResource IconButton}" Command="{Binding RefreshAddressesCommand}"
                            ToolTip="Ağ adreslerini yenile" Margin="0,0,8,0" />
                    <Button Command="{Binding StartPairingCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xED14;" Margin="0,0,8,0" />
                            <TextBlock Text="Cihaz eşleştir" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: pairing QR + live connections -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                        Visibility="{Binding IsPairing, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xED14;" Foreground="{StaticResource Accent}" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Telefonla eşleştir" Margin="0" />
                        </StackPanel>
                        <Border Background="White" CornerRadius="12" Padding="10" HorizontalAlignment="Center">
                            <Image Source="{Binding QrImage}" Width="180" Height="180" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,4">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,0,6,0" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding PairingCountdown}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="QR'ı tarayın ya da telefonda &quot;Bilgisayar ekle&quot; listesinden bu bilgisayarı seçin." />
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding CancelPairingCommand}" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="İptal" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" MinHeight="150">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE701;" Foreground="{StaticResource Accent}" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Aktif bağlantılar" Margin="0" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top" Margin="0,8,0,8" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Connections.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8EA;" FontSize="28" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center" Opacity="0.6" />
                            <TextBlock Style="{StaticResource Caption}" Text="Şu anda bağlı cihaz yok." Margin="0,8,0,0" HorizontalAlignment="Center" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Connections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ConnectionItem}">
                                    <Border Style="{StaticResource ListItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconTile}" Margin="0,0,12,0">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8EA;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Address}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#33F5B841" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsControlling}" Value="True">
                                                                <Setter Property="Background" Value="#333FCF8E" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsControlling}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Right: paired devices -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" Foreground="{StaticResource Accent}" Margin="0,0,8,0" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Eşleştirilmiş cihazlar" Margin="0" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" Margin="0,8,0,8" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PairedDevices.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="28" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center" Opacity="0.6" />
                        <TextBlock Style="{StaticResource Caption}" Text="Henüz eşleştirilmiş telefon yok. &quot;Cihaz eşleştir&quot;e basın." Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PairedDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PairedDeviceItem}">
                                    <Border Style="{StaticResource ListItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconTile}" Margin="0,0,12,0">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8EA;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <Border Background="#333FCF8E" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="bağlı" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Success}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="&#xE74D;" Style="{StaticResource DangerIconButton}" VerticalAlignment="Center"
                                                    ToolTip="Eşleştirmeyi kaldır" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer: server details -->
        <WrapPanel Grid.Row="2" Margin="0,16,0,0">
            <Border Style="{StaticResource Chip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE968;" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource Caption}"><Run Text="Sunucu:" /> <Run Text="{Binding ServerStatus, Mode=OneWay}" Foreground="{StaticResource PrimaryText}" /></TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Chip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE701;" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource Caption}"><Run Text="Adres:" /> <Run Text="{Binding Endpoint, Mode=OneWay}" Foreground="{StaticResource PrimaryText}" /></TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Chip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE962;" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource Caption}"><Run Text="Son komut:" /> <Run Text="{Binding LastActivity, Mode=OneWay}" Foreground="{StaticResource PrimaryText}" /></TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Chip}" ToolTip="{Binding Fingerprint}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource Caption}" Text="TLS ile şifreli · parmak izi için üzerine gelin" />
                </StackPanel>
            </Border>
        </WrapPanel>
    </Grid>
</Window>
