<Window x:Class="PocketPad.Desktop.Views.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PocketPad – Eşleştirme isteği"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True"
        Icon="pack://application:,,,/PocketPad.Desktop;component/Assets/PocketPad.ico"
        Style="{StaticResource AppWindow}">
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource IconTile}" Width="48" Height="48" CornerRadius="12" Margin="0,0,14,0">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8EA;" FontSize="22" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Yeni cihaz eşleştirmek istiyor" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Caption}" Text="Bu isteği siz başlatmadıysanız reddedin." />
            </StackPanel>
        </StackPanel>

        <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,14" TextWrapping="Wrap"
                   Text="İzin verirseniz bu cihaz bilgisayarınızda fare, klavye ve medya kontrolü yapabilecek." />

        <Border Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8EA;" FontSize="13" Foreground="{StaticResource SecondaryText}" Margin="0,0,8,8" />
                <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="Cihaz" Margin="0,0,16,8" />
                <TextBlock Grid.Column="2" x:Name="DeviceNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

                <TextBlock Grid.Row="1" Style="{StaticResource Icon}" Text="&#xE7F8;" FontSize="13" Foreground="{StaticResource SecondaryText}" Margin="0,0,8,8" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Caption}" Text="Platform" Margin="0,0,16,8" />
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="PlatformText" Margin="0,0,0,8" />

                <TextBlock Grid.Row="2" Style="{StaticResource Icon}" Text="&#xE701;" FontSize="13" Foreground="{StaticResource SecondaryText}" Margin="0,0,8,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Caption}" Text="Adres" Margin="0,0,16,0" />
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="AddressText" />
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource SubtleButton}" IsCancel="True" Click="OnDeny" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Reddet" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Click="OnApprove">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8FB;" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="İzin ver" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
